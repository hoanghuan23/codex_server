{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fields",
    "rows",
    "analysis"
  ],
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tên cột duy nhất của bảng được trích từ văn bản. Mỗi đại lượng độc lập có một cột; chi tiết giải thích/phạm vi đơn lẻ được giữ trong cột ghi chú, không nhân đôi chỉ số."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Mỗi dòng có đúng số ô theo thứ tự fields; null khi thiếu dữ liệu. Mỗi quan sát chỉ xuất hiện một lần; không lặp các dòng hoặc cả bảng."
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    }
  },
  "$defs": {
    "legend": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregation",
            "type",
            "mode",
            "title",
            "unit",
            "domain",
            "center",
            "stops",
            "reason"
          ],
          "properties": {
            "aggregation": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "sum",
                    "mean",
                    "min",
                    "max",
                    "count"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "continuous"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "semantic"
              ]
            },
            "title": {
              "type": "string"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "domain": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "center": {
              "type": "null"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "color"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  }
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregation",
            "type",
            "mode",
            "title",
            "unit",
            "domain",
            "center",
            "stops",
            "reason"
          ],
          "properties": {
            "aggregation": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "sum",
                    "mean",
                    "min",
                    "max",
                    "count"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "diverging"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "semantic"
              ]
            },
            "title": {
              "type": "string"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "domain": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "center": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "minItems": 3,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "color"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  }
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregation",
            "type",
            "mode",
            "title",
            "unit",
            "domain",
            "center",
            "stops",
            "reason",
            "combinations"
          ],
          "properties": {
            "aggregation": {
              "type": "null"
            },
            "type": {
              "type": "string",
              "enum": [
                "categorical"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "semantic"
              ]
            },
            "title": {
              "type": "string"
            },
            "unit": {
              "type": "null"
            },
            "domain": {
              "type": "null"
            },
            "center": {
              "type": "null"
            },
            "stops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "color"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  }
                }
              }
            },
            "combinations": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "values",
                  "color"
                ],
                "properties": {
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "maxItems": 12
                  },
                  "color": {
                    "type": "string"
                  }
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "geographicScopes": {
      "type": "array",
      "maxItems": 300,
      "description": "Phạm vi ngoại lệ của từng giá trị bindings.region; [] nếu mọi dòng dùng đúng cấp địa lý chung. Không thay đổi dữ liệu gốc.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceValue",
          "render",
          "targetName",
          "geoLevel",
          "country",
          "geometryPart",
          "label",
          "reason"
        ],
        "properties": {
          "sourceValue": {
            "type": "string",
            "description": "Giá trị nguyên văn trong cột bindings.region."
          },
          "render": {
            "type": "string",
            "enum": [
              "boundary",
              "marker",
              "unresolved"
            ]
          },
          "targetName": {
            "anyOf": [
              {
                "type": "string",
                "description": "Địa danh thực sự cần tra; marker dùng địa danh làm mốc đặt ký hiệu, không phải vùng được tô."
              },
              {
                "type": "null"
              }
            ]
          },
          "geoLevel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "country",
                  "admin1",
                  "admin2"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "Quốc gia cha của vùng con; null khi lấy từ cột ngữ cảnh của từng dòng."
              },
              {
                "type": "null"
              }
            ]
          },
          "geometryPart": {
            "type": "string",
            "enum": [
              "all",
              "largest"
            ],
            "description": "largest chỉ khi dữ liệu nêu rõ đảo/khối đất chính, không phải toàn địa giới hành chính gồm các đảo xa."
          },
          "label": {
            "type": "string",
            "description": "Tên phạm vi/ký hiệu ngắn, không chứa hậu tố lớp riêng; ứng dụng tự thêm hậu tố trong chú giải."
          },
          "reason": {
            "type": "string",
            "description": "Giải thích phạm vi từ dữ liệu; marker chỉ là ký hiệu điều kiện, không khẳng định toàn vùng áp dụng."
          }
        }
      }
    },
    "popupContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titleField",
        "imageFields",
        "descriptionFields",
        "addressFields",
        "linkFields"
      ],
      "properties": {
        "titleField": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "imageFields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "descriptionFields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "addressFields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "linkFields": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetTitle",
        "grain",
        "columns",
        "suggestions",
        "search_bar",
        "search_fields",
        "regionNavigation",
        "popupContent"
      ],
      "properties": {
        "popupContent": {
          "$ref": "#/$defs/popupContent"
        },
        "datasetTitle": {
          "type": "string"
        },
        "grain": {
          "type": "string"
        },
        "search_bar": {
          "type": "boolean",
          "description": "Có nên bật tìm kiếm mặc định theo số đối tượng và lợi ích tìm nhanh; không dùng ngưỡng 30 cứng."
        },
        "search_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tên cột gốc có thật để tìm đối tượng: tên định danh chính trước, ngữ cảnh sau; không chọn cột đo lường."
        },
        "regionNavigation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "countryField",
                "regions"
              ],
              "description": "Dropdown lọc khu vực khi dữ liệu chứa tên/mã quốc gia; null khi không phù hợp. Dùng các ID khu vực có sẵn, theo thứ tự AI đề xuất.",
              "properties": {
                "countryField": {
                  "type": "string",
                  "description": "Tên cột gốc chứa quốc gia, role geo và geoLevel country."
                },
                "regions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 22,
                  "items": {
                    "type": "string",
                    "enum": [
                      "subregion:Latin America and the Caribbean",
                      "subregion:Southern Asia",
                      "subregion:Sub-Saharan Africa",
                      "subregion:Northern Europe",
                      "subregion:Southern Europe",
                      "subregion:Western Asia",
                      "subregion:Polynesia",
                      "subregion:Australia and New Zealand",
                      "subregion:Western Europe",
                      "subregion:Eastern Europe",
                      "subregion:Northern America",
                      "subregion:South-eastern Asia",
                      "subregion:Eastern Asia",
                      "subregion:Northern Africa",
                      "subregion:Melanesia",
                      "subregion:Micronesia",
                      "subregion:Central Asia",
                      "region:Americas",
                      "region:Asia",
                      "region:Africa",
                      "region:Europe",
                      "region:Oceania"
                    ]
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "labelVi",
              "geoLevel",
              "country",
              "timeParse",
              "granularity",
              "unit",
              "unitSource",
              "aggDefault",
              "semanticType",
              "legend"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "geo",
                  "time",
                  "measure",
                  "category",
                  "id",
                  "text",
                  "ignore"
                ]
              },
              "labelVi": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geoLevel": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "country",
                      "admin1",
                      "admin2",
                      "point_lat",
                      "point_lng",
                      "h3"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "country": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeParse": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "iso",
                      "excel_serial",
                      "unix_s",
                      "unix_ms",
                      "text"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "granularity": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Đơn vị đo của dữ liệu, được xác định từ tên cột và ngữ cảnh toàn bảng, ví dụ °C, °F, mm, %, triệu đồng. Giữ đơn vị kể cả khi legend.mode là auto; chỉ null khi không xác định được."
              },
              "unitSource": {
                "type": "string",
                "enum": [
                  "explicit",
                  "inferred",
                  "unknown"
                ]
              },
              "aggDefault": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "sum",
                      "mean",
                      "max",
                      "min",
                      "count"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "semanticType": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "legend": {
                "$ref": "#/$defs/legend"
              }
            }
          }
        },
        "suggestions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "chartType",
              "title",
              "bindings",
              "agg",
              "confidence",
              "reason",
              "legend",
              "popupSuggestions",
              "metricButtons",
              "geographicScopes"
            ],
            "properties": {
              "geographicScopes": {
                "$ref": "#/$defs/geographicScopes"
              },
              "id": {
                "type": "string"
              },
              "chartType": {
                "type": "string",
                "enum": [
                  "choropleth",
                  "map_line",
                  "point",
                  "arc_flow"
                ]
              },
              "title": {
                "type": "string"
              },
              "bindings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "region",
                  "value",
                  "lat",
                  "lng",
                  "x",
                  "y",
                  "series",
                  "source",
                  "target",
                  "sourceLat",
                  "sourceLng",
                  "targetLat",
                  "targetLng",
                  "time",
                  "group"
                ],
                "properties": {
                  "source": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "target": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceLat": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceLng": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "targetLat": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "targetLng": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "time": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "group": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "region": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lat": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lng": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "x": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "y": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "minItems": 1
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "series": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "agg": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "sum",
                      "mean",
                      "max",
                      "min",
                      "count"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string"
              },
              "legend": {
                "$ref": "#/$defs/legend"
              },
              "metricButtons": {
                "type": "array",
                "description": "Các nút chọn chỉ số do AI thiết kế riêng cho bản đồ này, theo đúng thứ tự hiển thị; [] nếu không cần chọn nhanh.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "label",
                    "icon",
                    "color"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Tên cột gốc có thật, phù hợp để tô màu Polygon/Line hoặc làm kích thước Point."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "description": "Nhãn tiếng Việt ngắn, giữ đúng ý nghĩa cột; không tự đổi đơn vị."
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12,
                      "description": "Một emoji hoặc ký hiệu Unicode phù hợp nội dung chỉ số; không sinh HTML, SVG, URL hay code."
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "description": "Màu nền biểu tượng do AI chọn theo ý nghĩa chỉ số."
                    }
                  }
                }
              },
              "popupSuggestions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "confidence"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": [
                        "info",
                        "info_image",
                        "bar",
                        "line"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
